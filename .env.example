# Glean
GLEAN_API_TOKEN=your_glean_api_token
GLEAN_INSTANCE=yourcompany
GLEAN_SERVER_URL=https://yourcompany-be.glean.com
GLEAN_ACT_AS=you@yourcompany.com

# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_BOT_USER_ID=YOUR_BOT_USER_ID
SLACK_ERROR_CHANNEL=YOUR_ERROR_CHANNEL_ID
SLACK_TEST_CHANNEL=YOUR_TEST_CHANNEL_ID
SLACK_MONITORING_CHANNEL=YOUR_MONITORING_CHANNEL_ID
SLACK_NOTIFY_USER_ID=YOUR_USER_ID

# Google
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_CREDENTIALS_PATH=google-credentials.json
PITCH_DOCS_FOLDER_ID=your_google_drive_folder_id

# Gemini / Vertex AI
GEMINI_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1
GEMINI_SERVICE_ACCOUNT={"type":"service_account",...}

# Web search (optional — for journalist discovery supplement)
SERPER_API_KEY=your_serper_api_key
